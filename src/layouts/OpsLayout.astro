---
// 運営パネル共通のレイアウト。lang は解決済みの言語、noindex、OG なし。
// ctx(ログイン後のページの共通値)があるときだけ、ヘッダーの操作者名・ログアウト・ナビ・お知らせを出す。
// 文言はすべてカタログ経由(docs/ARCHITECTURE.md 13 章)。
// サーバーの切り替え(docs/ARCHITECTURE.md 15.5): ヘッダーのセレクトは ?server= を送る GET フォーム(JS 無しでも動く。
// JS があれば選択で即送信)。現在のパスを保つ。ナビのリンクには ?server=<選択中の id> を付け、
// 複数タブで別々のサーバーを開いていても Cookie の書き換えで他のタブが別サーバーに変わらないようにする。
import '../styles/ops.css';
import SessionNotices from '../components/SessionNotices';
import { formatDateTime, getTranslator, toLocale } from '../i18n';
import type { Language, MessageKey } from '../i18n';
import type { PageContext } from './page-context';
import type { ServerSummary } from '../types/api';
import { serverLabel } from '../components/lib/servers';

export type NavId = 'status' | 'players' | 'bans' | 'audit' | 'servers';

interface Props {
  title: string;
  language: Language;
  ctx?: PageContext;
  active?: NavId;
  /** ログイン・設定画面など、幅を絞った 1 カラム表示 */
  narrow?: boolean;
}

const { title, language, ctx, active, narrow = false } = Astro.props;
const t = getTranslator(language);
const appName = t('app.name');
const fullTitle = title === appName ? appName : t('layout.title', { page: title, app: appName });

const NAV: { id: NavId; href: string; label: MessageKey }[] = [
  { id: 'status', href: '/', label: 'nav.status' },
  { id: 'players', href: '/players', label: 'nav.players' },
  { id: 'bans', href: '/bans', label: 'nav.bans' },
  { id: 'audit', href: '/audit', label: 'nav.audit' },
  { id: 'servers', href: '/servers', label: 'nav.servers' },
];

const currentServerId = ctx?.serverId ?? null;
const withServer = (href: string) => (currentServerId ? `${href}?server=${encodeURIComponent(currentServerId)}` : href);

// セレクトに出すのは有効なサーバー(選択中のものは無効でも出す。今どれを見ているか分かるように)
const switchable: ServerSummary[] = ctx ? ctx.servers.filter((s) => s.enabled || s.id === currentServerId) : [];
const optionLabel = (s: ServerSummary): string => {
  const name = serverLabel(s, t);
  if (!s.enabled) return t('header.serverDisabled', { name });
  if (s.needsPassword) return t('header.serverNeedsPassword', { name });
  if (!s.usable) return t('header.serverUnusable', { name });
  return name;
};
const currentPath = Astro.url.pathname;

const session = ctx?.session ?? null;
const operatorText = session
  ? session.operator
    ? t('header.operator', { name: session.operator })
    : t('header.operatorAnonymous', { tag: session.sessionTag })
  : null;
const expiresText =
  session && ctx
    ? t('header.sessionExpires', {
        time: formatDateTime(session.expiresAt, toLocale(language), ctx.timeZone, { dateStyle: 'short', timeStyle: 'short' }),
      })
    : null;
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('layout.skipToMain')}</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={session ? withServer('/') : '/login'}>{appName}</a>
        {session && ctx && switchable.length > 0 && (
          <form class="server-switch" method="get" action={currentPath} data-server-switch>
            <label for="server-select">{t('header.server')}</label>
            <select id="server-select" name="server">
              {ctx.serverNotFound && (
                <option value="" selected disabled>{t('server.notFound.title')}</option>
              )}
              {switchable.map((s) => (
                <option value={s.id} selected={s.id === currentServerId && !ctx.serverNotFound}>{optionLabel(s)}</option>
              ))}
            </select>
            <button type="submit" class="button-small">{t('header.serverSwitch')}</button>
          </form>
        )}
        {session && (
          <div class="header-session">
            <span>{operatorText}</span>
            <span>{expiresText}</span>
            <form method="post" action="/logout">
              <button type="submit" class="button-small">{t('logout.submit')}</button>
            </form>
          </div>
        )}
      </div>
    </header>
    {session && (
      <nav class="site-nav" aria-label={t('nav.label')}>
        <div class="container">
          <ul>
            {NAV.map((item) => (
              <li>
                <a href={withServer(item.href)} aria-current={item.id === active ? 'page' : undefined}>{t(item.label)}</a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}
    <div class="container">
      {ctx && session && (
        <SessionNotices client:load language={language} initialFeatures={ctx.features} initialWarnings={ctx.warnings} />
      )}
    </div>
    <main id="main" class="container">
      <div class={narrow ? 'narrow' : undefined}>
        <slot />
      </div>
    </main>
    <script>
      // 選択したらすぐに切り替える(JS が無い場合は「切り替え」ボタンで送る)
      for (const form of document.querySelectorAll<HTMLFormElement>('form[data-server-switch]')) {
        const select = form.querySelector('select');
        select?.addEventListener('change', () => {
          if (select.value !== '') form.requestSubmit();
        });
      }
    </script>
  </body>
</html>
