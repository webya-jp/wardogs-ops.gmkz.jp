---
// 運営パネル共通のレイアウト。lang は解決済みの言語、noindex、OG なし。文言はすべてカタログ経由(docs/ARCHITECTURE.md 13 章)。
// - ctx とセッション(ログイン後)があるとき: 「サイドバー + ヘッダータブ + メイン」の 3 領域(docs/ARCHITECTURE.md 9.2)
//   HTML の順序は スキップリンク → ヘッダー → サイドバー → タブ → お知らせ → main。見た目の配置は CSS Grid で決める
//   幅 1024px 未満ではサイドバーをヘッダー直下の折りたたみパネルにする(9.5)。JS が無ければ常に開いた状態
// - それ以外(/setup・/login): 従来のヘッダー + 1 カラム
// サーバーの切り替え・操作者名・期限・ログアウトはサイドバーにある(Sidebar.astro)。
// タブ・アプリ名のリンクには ?server=<選択中の id> を付ける(15.5。複数タブで別々のサーバーを開いていても混ざらないように)。
import '../styles/ops.css';
import SessionNotices from '../components/SessionNotices';
import Sidebar from '../components/Sidebar.astro';
import { getTranslator } from '../i18n';
import type { Language } from '../i18n';
import type { PageContext } from './page-context';
import { NAV_ITEMS, hrefWithServer } from './nav';
import type { NavId } from './nav';

interface Props {
  title: string;
  language: Language;
  ctx?: PageContext;
  active?: NavId;
  /** ログイン・設定画面など、幅を絞った 1 カラム表示 */
  narrow?: boolean;
}

const { title, language, ctx, active, narrow = false } = Astro.props;
const t = getTranslator(language);
const appName = t('app.name');
const fullTitle = title === appName ? appName : t('layout.title', { page: title, app: appName });

const session = ctx?.session ?? null;
const shell = ctx !== undefined && session !== null;
const currentServerId = ctx?.serverId ?? null;
// <head> のインラインスクリプトは描画前に <html> へ js クラスを付ける(モバイルでサイドバーを閉じた状態から始めるため。
// JS が無ければ開いたまま。開閉ボタンも JS があるときだけ出す)
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    {shell && (
      <script is:inline>document.documentElement.classList.add('js');</script>
    )}
  </head>
  <body class={shell ? 'has-shell' : undefined}>
    <a class="skip-link" href="#main">{t('layout.skipToMain')}</a>
    {shell && ctx ? (
      <div class="shell">
        <header class="site-header shell-header">
          <a class="brand" href={hrefWithServer('/', currentServerId)}>{appName}</a>
          <button
            type="button"
            class="button-small sidebar-toggle"
            aria-controls="sidebar"
            aria-expanded="false"
            data-sidebar-toggle
            data-label-open={t('sidebar.toggle.open')}
            data-label-close={t('sidebar.toggle.close')}
            hidden
          >
            <span class="sidebar-toggle-icon" aria-hidden="true"></span>
            <span class="sidebar-toggle-label">{t('sidebar.toggle.open')}</span>
          </button>
        </header>
        <Sidebar ctx={ctx} active={active} />
        <nav class="shell-tabs" aria-label={t('tabs.label')}>
          <ul>
            {NAV_ITEMS.map((item) => (
              <li>
                <a href={hrefWithServer(item.href, currentServerId)} aria-current={item.id === active ? 'page' : undefined}>
                  {t(item.label)}
                  {item.comingSoon && <span class="tab-badge">{t('tabs.comingSoon')}</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="shell-notices">
          <SessionNotices client:load language={language} initialFeatures={ctx.features} initialWarnings={ctx.warnings} />
        </div>
        <main id="main" class="shell-main">
          <div class={narrow ? 'narrow' : undefined}>
            <slot />
          </div>
        </main>
      </div>
    ) : (
      <>
        <header class="site-header">
          <div class="container">
            <a class="brand" href="/login">{appName}</a>
          </div>
        </header>
        <main id="main" class="container">
          <div class={narrow ? 'narrow' : undefined}>
            <slot />
          </div>
        </main>
      </>
    )}
    <script>
      // サーバーのセレクトは選択したらすぐに切り替える(JS が無い場合は「切り替え」ボタンで送る)
      for (const form of document.querySelectorAll<HTMLFormElement>('form[data-server-switch]')) {
        const select = form.querySelector('select');
        select?.addEventListener('change', () => {
          if (select.value !== '') form.requestSubmit();
        });
      }

      // モバイル(1024px 未満)のサイドバーの開閉。開閉の状態は保存しない(ページ遷移ごとに閉じた状態に戻る)
      const toggle = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
      const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
      if (toggle && sidebar) {
        const label = toggle.querySelector('.sidebar-toggle-label');
        const setOpen = (open: boolean) => {
          sidebar.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          if (label) label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
        };
        toggle.hidden = false;
        setOpen(false);
        toggle.addEventListener('click', () => setOpen(!sidebar.classList.contains('is-open')));
      }

      // 現在のタブを見える位置に寄せる(タブ列だけが横にスクロールする)
      document
        .querySelector('.shell-tabs a[aria-current="page"]')
        ?.scrollIntoView({ inline: 'nearest', block: 'nearest' });
    </script>
  </body>
</html>
