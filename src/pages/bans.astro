---
// BAN(/bans)。docs/ARCHITECTURE.md 9 章。BAN 一覧と解除。手動更新。
export const prerender = false;
import OpsLayout from '../layouts/OpsLayout.astro';
import { getPageContext } from '../layouts/page-context';
import BansTable from '../components/BansTable';
import ServerGate from '../components/ServerGate.astro';
import { serverLabel } from '../components/lib/servers';

const ctx = await getPageContext(Astro.request, Astro.locals, Astro.response);
const server = ctx.server && !ctx.serverNotFound && ctx.server.usable ? { id: ctx.server.id, label: serverLabel(ctx.server, ctx.t) } : null;
---
<OpsLayout title={ctx.t('tabs.bans')} language={ctx.language} ctx={ctx} active="bans">
  <ServerGate ctx={ctx} />
  {server && <BansTable client:load language={ctx.language} timeZone={ctx.timeZone} writesEnabled={ctx.features.writes} server={server} />}
</OpsLayout>
