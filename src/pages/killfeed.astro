---
// キルフィード(/killfeed)。docs/ARCHITECTURE.md 9.6・17.9。スコア記録の推移のグラフと、受信した生データ(観測モード)。
// 中身はアイランド(KillfeedPanel)。選択中のサーバーが使えないときは ServerGate の案内だけを出す。
export const prerender = false;
import OpsLayout from '../layouts/OpsLayout.astro';
import { getPageContext } from '../layouts/page-context';
import KillfeedPanel from '../components/KillfeedPanel';
import ServerGate from '../components/ServerGate.astro';
import { serverLabel } from '../components/lib/servers';

const ctx = await getPageContext(Astro.request, Astro.locals, Astro.response);
const server = ctx.server && !ctx.serverNotFound && ctx.server.usable ? { id: ctx.server.id, label: serverLabel(ctx.server, ctx.t) } : null;
---
<OpsLayout title={ctx.t('tabs.killfeed')} language={ctx.language} ctx={ctx} active="killfeed">
  <ServerGate ctx={ctx} />
  {server && <KillfeedPanel client:load language={ctx.language} timeZone={ctx.timeZone} server={server} feedConfigured={ctx.server?.feedConfigured === true} />}
</OpsLayout>
