---
// 状態(/)。docs/ARCHITECTURE.md 9 章。サーバー名・マップ・人数・陣営スコア・ローテーション位置と、broadcast・マップ変更・試合終了。
export const prerender = false;
import OpsLayout from '../layouts/OpsLayout.astro';
import { getPageContext } from '../layouts/page-context';
import StatusPanel from '../components/StatusPanel';
import ServerGate from '../components/ServerGate.astro';
import { serverLabel } from '../components/lib/servers';

const ctx = await getPageContext(Astro.request, Astro.locals, Astro.response);
const server = ctx.server && !ctx.serverNotFound && ctx.server.usable ? { id: ctx.server.id, label: serverLabel(ctx.server, ctx.t) } : null;
---
<OpsLayout title={ctx.t('nav.status')} language={ctx.language} ctx={ctx} active="status">
  <ServerGate ctx={ctx} />
  {server && <StatusPanel client:load language={ctx.language} timeZone={ctx.timeZone} writesEnabled={ctx.features.writes} server={server} />}
</OpsLayout>
