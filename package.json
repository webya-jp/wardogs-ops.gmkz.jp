{
  "name": "wardogs-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WARDOGS コミュニティサーバー運営者向けの RCON 操作パネル(Cloudflare Workers 用テンプレート)",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "test": "vitest run",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "deploy:env": "node scripts/deploy-env.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types src/types/worker-configuration.d.ts",
    "mock:rcon": "node scripts/mock-rcon.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "astro": "^7.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "パネルのデータ(管理パスワードのハッシュ、登録したサーバー、操作ログ)を保存する D1 データベース。既定の名前のままで構いません。パスワードなどの入力はここでは不要です(デプロイ後にパネルの画面で登録します)。"
      }
    }
  }
}
